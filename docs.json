{
  "$schema": "https://mintlify.com/schema.json",
  "name": "updates.page",
  "theme": "maple",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#000000",
    "light": "#3B82F6",
    "dark": "#000000"
  },
  "topbarLinks": [
    {
      "name": "Dashboard",
      "url": "https://app.updates.page"
    }
  ],
  "topbarCtaButton": {
    "name": "Get Started",
    "url": "https://app.updates.page/signup"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "quickstart",
          "first-post",
          "agents"
        ]
      },
      {
        "group": "Posts",
        "pages": [
          "posts/writing",
          "posts/categories",
          "posts/scheduling",
          "posts/cover-images",
          "posts/importing"
        ]
      },
      {
        "group": "Portal",
        "pages": [
          "portal/overview",
          "portal/custom-domain",
          "portal/customization",
          "portal/seo",
          "portal/analytics",
          "portal/subscriptions"
        ]
      },
      {
        "group": "Embeds",
        "pages": [
          "embeds/overview",
          "embeds/widget",
          "embeds/inline",
          "embeds/styling"
        ]
      },
      {
        "group": "Apps",
        "pages": [
          "apps/overview",
          "apps/kit",
          "apps/webhook"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api/authentication",
          "api/posts",
          "api/categories"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/overview"
        ]
      },
      {
        "group": "Team",
        "pages": [
          "team/members",
          "team/roles"
        ]
      },
      {
        "group": "Billing",
        "pages": [
          "billing/plans",
          "billing/faq"
        ]
      }
    ]
  },
  "footerSocials": {
    "x": "https://x.com/stratuslabs",
    "github": "https://github.com/stratuslabs"
  },
  "redirects": [
    {
      "source": "/announcements/:slug*",
      "destination": "/posts/:slug*"
    },
    {
      "source": "/first-announcement",
      "destination": "/first-post"
    },
    {
      "source": "/api/announcements",
      "destination": "/api/posts"
    }
  ],
  "api": {
    "openapi": "https://app.updates.page/api/openapi.json"
  }
}
