{
  "$schema": "https://mintlify.com/schema.json",
  "name": "updates.page",
  "theme": "maple",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#000000",
    "light": "#3B82F6",
    "dark": "#000000",
    "anchors": {
      "from": "#000000",
      "to": "#3B82F6"
    }
  },
  "topbarLinks": [
    {
      "name": "Dashboard",
      "url": "https://app.updates.page"
    }
