  },
  "tabs": [
    {
      "name": "Documentation",
      "url": "/"
    },
    {
      "name": "API Reference",
      "url": "/api"
    }
  ],
  "anchors": [
    {
      "name": "Community",
      "icon": "discord",
      "url": "https://discord.gg/updatespage"
    },
    {
      "name": "Blog",
      "icon": "newspaper",
      "url": "https://updates.page/blog"
    }
